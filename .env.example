# ============================================================
# BuddyKeyManagerDesktop 运行环境配置模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 排除，不会提交）
# 变量名与 app/config.py 中实际读取的 BKM_* 一一对应
# ============================================================

# ---------------- 服务监听 ----------------
# 监听地址：127.0.0.1（仅本机，推荐） / 0.0.0.0（局域网可访问，请谨慎）
BKM_HOST=127.0.0.1
# 监听端口
BKM_PORT=8765
# 创建授权会话后是否自动打开默认浏览器：true / false
BKM_OPEN_BROWSER=true

# ---------------- 数据目录 ----------------
# 存放加密凭证(credentials.enc)、会话(sessions.json)、设置(settings.enc)与密钥(.key)
# 默认 ./data，可用绝对路径改到其他盘符
BKM_DATA_DIR=./data
